# Public site settings
NEXT_PUBLIC_SITE_URL=https://durbaan.com
# WhatsApp Business number in international format, digits only (e.g. 252612345678)
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Cal.com booking link, e.g. https://cal.com/durbaan/discovery
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_LINKEDIN_URL=
# Plausible analytics domain (leave empty to disable analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend email delivery
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@durbaan.com
CONTACT_FROM_EMAIL=Durbaan <hello@durbaan.com>
# Optional: newsletter audience in Resend
RESEND_AUDIENCE_ID=
# Set to 1 to show draft/sample content (preview deployments only, never production)
NEXT_PUBLIC_SHOW_DRAFTS=
